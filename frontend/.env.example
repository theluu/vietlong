# Copy to `frontend/.env` and fill in. `.env` is gitignored.

# Drupal API. Leave unset to use the ddev default.
# NUXT_PUBLIC_API_BASE=https://vietlong.ddev.site/api/v1

# reCAPTCHA v3 SITE key (public — it ships in the page source).
# The matching SECRET key goes in web/sites/default/settings.php, never here.
# Leave empty to run without reCAPTCHA: forms still submit, verification is skipped.
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
