<?php

/**
 * @file
 * Hook implementations for Keybolts Core.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_entity_presave().
 *
 * Denormalises a diacritic-free search string onto the product so that
 * suggest queries are a plain indexed LIKE rather than a runtime transform.
 */
function keybolts_core_entity_presave(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'product') {
    return;
  }
  if (!$entity->hasField('field_search_text')) {
    return;
  }

  $parts = [$entity->label()];
  foreach (['field_product_code', 'field_family'] as $field) {
    if ($entity->hasField($field) && !$entity->get($field)->isEmpty()) {
      $parts[] = $entity->get($field)->value;
    }
  }
  foreach (['field_category', 'field_brand', 'field_finish'] as $field) {
    if ($entity->hasField($field) && !$entity->get($field)->isEmpty()) {
      $term = $entity->get($field)->entity;
      if ($term) {
        $parts[] = $term->label();
      }
    }
  }

  $normalizer = \Drupal::service('keybolts_core.text_normalizer');
  $entity->set('field_search_text', $normalizer->normalize(implode(' ', $parts)));
}

/**
 * Implements hook_user_login().
 *
 * Editors land on the dashboard rather than their user profile, which is the
 * Drupal default and tells them nothing. Administrators keep the default so
 * their own workflow is untouched.
 */
function keybolts_core_user_login(\Drupal\user\UserInterface $account): void {
  if (!in_array('bien_tap_vien', $account->getRoles(), TRUE)) {
    return;
  }
  $request = \Drupal::request();
  if (!$request->query->has('destination')) {
    $request->query->set('destination', '/admin/keybolts');
  }
}

/**
 * Implements hook_toolbar_alter().
 *
 * Trims an editor's toolbar to what they can actually use. The administration
 * tray itself stays — Drupal already filters it by permission, and removing it
 * outright leaves them with no way back to the dashboard from a form.
 */
function keybolts_core_toolbar_alter(&$items): void {
  if (\Drupal::currentUser()->hasPermission('administer site configuration')) {
    return;
  }
  // The dashboard lists every page and collection, and the back bar sits on
  // every other admin screen, so the tray only repeats what is already one
  // click away. The account tab stays: it confirms who is signed in.
  foreach (['shortcuts', 'tour', 'devel', 'contextual', 'home', 'administration'] as $tab) {
    unset($items[$tab]);
  }
}

/**
 * Implements hook_page_top().
 *
 * A bar back to the dashboard on every admin page except the dashboard
 * itself. Without it the only way back from an edit form is the browser
 * button or a small toolbar tab, which is the first thing a non-technical
 * editor gets stuck on.
 */
function keybolts_core_page_top(array &$page_top): void {
  $account = \Drupal::currentUser();
  if (!in_array('bien_tap_vien', $account->getRoles(), TRUE)) {
    return;
  }
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'keybolts_core.dashboard' || !\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }
  $page_top['keybolts_back'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['kb-backbar']],
    '#attached' => ['library' => ['keybolts_core/dashboard']],
    'back' => [
      '#type' => 'link',
      '#title' => \Drupal\Core\Render\Markup::create(
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" '
        . 'stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>'
        . '<span>Về trang quản trị</span>'
      ),
      '#url' => \Drupal\Core\Url::fromRoute('keybolts_core.dashboard'),
      '#attributes' => ['class' => ['kb-backbar-link']],
    ],
    'site' => [
      '#type' => 'link',
      '#title' => \Drupal\Core\Render\Markup::create(
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" '
        . 'stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/>'
        . '<path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg>'
        . '<span>Xem website</span>'
      ),
      '#url' => \Drupal\Core\Url::fromUri('base:/'),
      '#attributes' => ['class' => ['kb-backbar-link', 'kb-backbar-link--ghost'], 'target' => '_blank'],
    ],
  ];
}

/**
 * Implements hook_menu_links_discovered_alter().
 *
 * Points the admin root at the dashboard for everyone. /admin is a list of
 * Drupal's own subsystems; the dashboard is a list of the client's pages.
 */
function keybolts_core_menu_links_discovered_alter(&$links): void {
  if (isset($links['keybolts_core.dashboard'])) {
    $links['keybolts_core.dashboard']['weight'] = -100;
  }
}

/**
 * Implements hook_preprocess_menu().
 *
 * Prunes the admin menu for editors. Drupal already hides what they lack
 * permission for, but sections like Structure still appear because they hold
 * one thing an editor needs (menus) alongside a dozen they must not touch.
 * The dashboard links straight to that one thing, so the section is noise.
 */
function keybolts_core_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'admin') {
    return;
  }
  if (\Drupal::currentUser()->hasPermission('administer site configuration')) {
    return;
  }
  $hide = [
    // Duplicates the back bar's "Xem website" and reads in English.
    '<front>',
    'system.admin_structure',
    'system.admin_config',
    'system.themes_page',
    'system.modules_list',
    'system.admin_reports',
    'entity.user.collection',
    'help.main',
  ];
  $variables['items'] = array_filter(
    $variables['items'],
    static function (array $item) use ($hide): bool {
      $url = $item['url'] ?? NULL;
      return !$url || !$url->isRouted() || !in_array($url->getRouteName(), $hide, TRUE);
    }
  );
}

/**
 * Implements hook_form_alter().
 *
 * The action buttons on a node form read "Save", "Preview", "Delete" in
 * English and are styled like every other button on the page. For an editor
 * who came to change one sentence, the button that commits the change should
 * be the most obvious thing on screen and should be in their language.
 */
function keybolts_core_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  // Node forms are node_{type}_form when adding and node_{type}_edit_form when
  // editing, so matching on a single suffix misses half of them.
  if (!str_starts_with($form_id, 'node_') || !isset($form['actions'])) {
    return;
  }
  if (!in_array('bien_tap_vien', \Drupal::currentUser()->getRoles(), TRUE)) {
    return;
  }
  $labels = [
    'submit' => 'Lưu thay đổi',
    'preview' => 'Xem thử',
    'delete' => 'Xoá',
  ];
  foreach ($labels as $key => $label) {
    if (isset($form['actions'][$key]['#value'])) {
      $form['actions'][$key]['#value'] = t($label);
    }
    if (isset($form['actions'][$key]['#title'])) {
      $form['actions'][$key]['#title'] = t($label);
    }
  }
  $form['actions']['#attributes']['class'][] = 'kb-formactions';
  $form['#attached']['library'][] = 'keybolts_core/dashboard';

  // Saving drops an editor on the node's own page, which is a bare render of
  // fields on a headless site and tells them nothing. Send them back to the
  // dashboard they started from.
  if (isset($form['actions']['submit']['#submit'])) {
    $form['actions']['submit']['#submit'][] = 'keybolts_core_return_to_dashboard';
  }
}

/**
 * Submit handler: returns an editor to the dashboard after saving.
 */
function keybolts_core_return_to_dashboard(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  // A destination in the URL is an explicit instruction from elsewhere in the
  // admin — respect it rather than overriding.
  if (!\Drupal::request()->query->has('destination')) {
    $form_state->setRedirect('keybolts_core.dashboard');
  }
}
