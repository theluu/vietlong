<?php

/**
 * @file
 * Hook implementations for Keybolts Core.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_entity_presave().
 *
 * Denormalises a diacritic-free search string onto the product so that
 * suggest queries are a plain indexed LIKE rather than a runtime transform.
 */
function keybolts_core_entity_presave(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'product') {
    return;
  }
  if (!$entity->hasField('field_search_text')) {
    return;
  }

  $parts = [$entity->label()];
  foreach (['field_product_code', 'field_family'] as $field) {
    if ($entity->hasField($field) && !$entity->get($field)->isEmpty()) {
      $parts[] = $entity->get($field)->value;
    }
  }
  foreach (['field_category', 'field_brand', 'field_finish'] as $field) {
    if ($entity->hasField($field) && !$entity->get($field)->isEmpty()) {
      $term = $entity->get($field)->entity;
      if ($term) {
        $parts[] = $term->label();
      }
    }
  }

  $normalizer = \Drupal::service('keybolts_core.text_normalizer');
  $entity->set('field_search_text', $normalizer->normalize(implode(' ', $parts)));
}

/**
 * Implements hook_user_login().
 *
 * Editors land on the dashboard rather than their user profile, which is the
 * Drupal default and tells them nothing. Administrators keep the default so
 * their own workflow is untouched.
 */
function keybolts_core_user_login(\Drupal\user\UserInterface $account): void {
  if (!in_array('bien_tap_vien', $account->getRoles(), TRUE)) {
    return;
  }
  $request = \Drupal::request();
  if (!$request->query->has('destination')) {
    $request->query->set('destination', '/admin/keybolts');
  }
}

/**
 * Implements hook_toolbar_alter().
 *
 * Trims an editor's toolbar to what they can actually use. The administration
 * tray itself stays — Drupal already filters it by permission, and removing it
 * outright leaves them with no way back to the dashboard from a form.
 */
function keybolts_core_toolbar_alter(&$items): void {
  if (\Drupal::currentUser()->hasPermission('administer site configuration')) {
    return;
  }
  foreach (['shortcuts', 'tour', 'devel', 'contextual'] as $tab) {
    unset($items[$tab]);
  }
}

/**
 * Implements hook_menu_links_discovered_alter().
 *
 * Points the admin root at the dashboard for everyone. /admin is a list of
 * Drupal's own subsystems; the dashboard is a list of the client's pages.
 */
function keybolts_core_menu_links_discovered_alter(&$links): void {
  if (isset($links['keybolts_core.dashboard'])) {
    $links['keybolts_core.dashboard']['weight'] = -100;
  }
}

/**
 * Implements hook_preprocess_menu().
 *
 * Prunes the admin menu for editors. Drupal already hides what they lack
 * permission for, but sections like Structure still appear because they hold
 * one thing an editor needs (menus) alongside a dozen they must not touch.
 * The dashboard links straight to that one thing, so the section is noise.
 */
function keybolts_core_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'admin') {
    return;
  }
  if (\Drupal::currentUser()->hasPermission('administer site configuration')) {
    return;
  }
  $hide = [
    'system.admin_structure',
    'system.admin_config',
    'system.themes_page',
    'system.modules_list',
    'system.admin_reports',
    'entity.user.collection',
    'help.main',
  ];
  $variables['items'] = array_filter(
    $variables['items'],
    static function (array $item) use ($hide): bool {
      $url = $item['url'] ?? NULL;
      return !$url || !$url->isRouted() || !in_array($url->getRouteName(), $hide, TRUE);
    }
  );
}
