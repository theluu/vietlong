  "faqs": [
    {
      "q": "Khóa này lắp được cho cửa gỗ dày bao nhiêu?",
      "a": "Bộ khóa phù hợp cửa gỗ dày 40–55mm. Nếu cửa của bạn mỏng hoặc dày hơn khoảng này, hãy gọi hotline để được tư vấn model tương đương đúng kích thước."
    },
    {
      "q": "Mạ PVD có bị xỉn màu sau vài năm không?",
      "a": "Mạ PVD là mạ chân không, độ cứng bề mặt cao hơn mạ điện thông thường nên giữ màu bền trong môi trường ẩm. Với sử dụng bình thường trong nhà, màu gần như không đổi trong nhiều năm."
    },
    {
      "q": "Vì sao website không hiển thị giá?",
      "a": "Giá phụ thuộc vào size, hoàn thiện và số lượng. Với công trình và đại lý còn có chính sách riêng, nên Keybolts báo giá trực tiếp qua hotline 1900 9018 để đảm bảo giá đúng nhất cho từng đơn."
    },
    {
      "q": "Có xuất hóa đơn VAT và bảo hành giấy không?",
      "a": "Có. Keybolts xuất hóa đơn VAT cho cả đơn lẻ và đơn công trình, kèm phiếu bảo hành ghi rõ thời hạn theo dòng sản phẩm."
    }
  ],
